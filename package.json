{
  "name": "suffuse",
  "version": "0.4.0",
  "description": "MCP server and Agent Skill for capability-safe Govee lighting control",
  "type": "module",
  "license": "MIT",
  "author": "Andy Edmonds",
  "homepage": "https://github.com/andyed/suffuse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyed/suffuse.git"
  },
  "bugs": {
    "url": "https://github.com/andyed/suffuse/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "agent-skill",
    "govee",
    "lighting",
    "smart-home"
  ],
  "bin": {
    "suffuse": "scripts/govee.mjs",
    "suffuse-manage": "scripts/manage.mjs",
    "suffuse-mcp": "mcp/server.mjs"
  },
  "files": [
    ".claude-plugin/",
    ".mcp.json",
    "SKILL.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "agents/",
    "assets/",
    "mcp/",
    "references/",
    "scripts/",
    "tests/fixtures/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "doctor": "node scripts/manage.mjs doctor",
    "inspect:fixture": "node scripts/govee.mjs inspect --fixture tests/fixtures/segmented-device.json --sku H0001",
    "mcp:describe": "node mcp/server.mjs --describe",
    "palettes": "node scripts/govee.mjs palettes"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "culori": "^4.0.2",
    "zod": "^4.4.3"
  }
}
